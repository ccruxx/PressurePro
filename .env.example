# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Client (exposed to the browser via Vite, so non-secret by definition) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA4_ID=
# Google Search Console HTML verification token
VITE_GSC_HTML=

# --- Server (Vercel function api/send-quote.ts - set in Vercel, not here) ---
# Resend API key used to send quote emails
RESEND_API_KEY=
# Where owner notifications are delivered. NOTE: api/send-quote.ts currently
# falls back to info@dfwpristinepowerwashing.com, which does not match the
# business email used everywhere else (joshua.dfwpristine@gmail.com).
OWNER_EMAIL=

# VERCEL_OIDC_TOKEN is generated by `vercel env pull` / the Vercel CLI.
# It is short-lived and must never be committed.
